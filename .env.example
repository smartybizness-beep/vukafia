# ╔══════════════════════════════════════════════════╗
# ║        VUKAFIA API — ENVIRONMENT VARIABLES        ║
# ║   Copy this to .env and fill in your values       ║
# ╚══════════════════════════════════════════════════╝

# ── APP ──────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ── JWT (CHANGE IN PRODUCTION!) ──────────────────────
JWT_SECRET=vukafia_super_secret_key_change_me_in_prod_2025
JWT_EXPIRES=7d

# ── DATABASE ─────────────────────────────────────────
# Dev: Leave blank — uses SQLite automatically (data/vukafia.sqlite)
# Prod: Set your PostgreSQL URL (Railway / Supabase / Render)
DATABASE_URL=

# ── CORS ─────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:3000,https://vukafia.com,https://www.vukafia.com

# ── WHATSAPP (Meta Cloud API) ─────────────────────────
# Get from: https://developers.facebook.com/apps/
WA_PHONE_NUMBER=2348101477935
WA_PHONE_NUMBER_ID=your_phone_number_id_here
WA_API_TOKEN=your_meta_access_token_here
WA_VERIFY_TOKEN=vukafia_webhook_verify_2025

# ── PAYMENTS (optional — for subscriptions) ──────────
# Paystack (Nigeria/Africa)
PAYSTACK_SECRET_KEY=sk_live_your_paystack_key
PAYSTACK_PUBLIC_KEY=pk_live_your_paystack_key

# Flutterwave (alternative)
FLW_SECRET_KEY=FLWSECK_your_key
FLW_PUBLIC_KEY=FLWPUBK_your_key

# ── EMAIL (optional — for notifications) ─────────────
# Mailgun / SendGrid / Resend
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_USER=postmaster@vukafia.com
SMTP_PASS=your_smtp_password
FROM_EMAIL=noreply@vukafia.com

# ── CLOUDINARY (optional — for photo uploads) ────────
CLOUDINARY_CLOUD_NAME=vukafia
CLOUDINARY_API_KEY=your_key
CLOUDINARY_API_SECRET=your_secret

# ── AI SEARCH (natural-language search, optional) ────────────────────
# Without a key, search falls back to the built-in keyword parser.
ANTHROPIC_API_KEY=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
# AI_SEARCH_MODEL=claude-opus-5     # or claude-haiku-4-5 for cheaper/faster
# AI_SEARCH_ENABLED=true            # "false" forces the keyword fallback
